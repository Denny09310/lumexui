@namespace LumexUI
@inherits LumexComponentBase

@using S = PopoverSlots;

<span class="@GetStyles( nameof( S.Trigger ) )"
      data-slot="trigger"
      data-popovertarget="@Popover.Id"
      aria-expanded="@Popover.Open.ToAttributeValue()"
      @onclick="@Popover.TriggerAsync"
      @attributes="@AdditionalAttributes">
    @ChildContent
</span>