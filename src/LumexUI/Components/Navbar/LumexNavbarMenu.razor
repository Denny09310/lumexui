@namespace LumexUI
@inherits LumexComponentBase

@using S = NavbarSlots;

<LumexCollapse As="@As"
               Class="@GetStyles( nameof( S.Menu ) )"
               Style="@RootStyle"
               Expanded="@Expanded"
               data-slot="menu"
               @attributes="@AdditionalAttributes">
    @ChildContent
</LumexCollapse>
