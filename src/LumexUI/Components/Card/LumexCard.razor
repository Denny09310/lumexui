@namespace LumexUI
@inherits LumexComponentBase

@using S = CardSlots;

<CascadingValue TValue="CardContext" Value="@_context" IsFixed="@true">
    <LumexComponent Class="@GetStyles( nameof( S.Base ) )"
                    Style="@RootStyle"
                    data-slot="base"
                    @attributes="@AdditionalAttributes">
        @ChildContent
    </LumexComponent>
</CascadingValue>
