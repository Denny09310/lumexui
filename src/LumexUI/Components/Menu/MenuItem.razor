@namespace LumexUI
@inherits LumexComponentBase

@using S = MenuItemSlots;

@{
    Context.Register( this );
}

@code {
    protected internal virtual void Render( RenderTreeBuilder __builder )
    {
        <LumexComponent As="@As"
                        Class="@GetStyles( nameof( S.Base ) )"
                        Style="@Style"
                        data-slot="base"
                        data-disabled="@_disabled.ToAttributeValue()"
                        data-readonly="@ReadOnly.ToAttributeValue()"
                        @attributes="@AdditionalAttributes"
                        @onclick="@OnClickAsync">
            @StartContent

            @if( !string.IsNullOrEmpty( Description ) )
            {
                <div class="@GetStyles( nameof( S.Wrapper ) )"
                     data-slot="wrapper">
                    <span class="@GetStyles( nameof( S.Title ) )"
                          data-slot="title">
                        @ChildContent
                    </span>
                    <span class="@GetStyles( nameof( S.Description ) )"
                          data-slot="description">
                        @Description
                    </span>
                </div>
            }
            else
            {
                <span class="@GetStyles( nameof( S.Title ) )"
                      data-slot="title">
                    @ChildContent
                </span>
            }

            @EndContent
        </LumexComponent>
    }
}
