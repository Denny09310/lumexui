@namespace LumexUI
@inherits LumexComponentBase

<div class="@_slots.GetBase()" data-slot="base">
    @ChildContent

    <LumexComponent As="@As"
                    Class="@_slots.GetBadge()"
                    Style="@Style"
                    data-slot="badge"
                    data-invisible="@Invisible.ToAttributeValue()"
                    @attributes="@AdditionalAttributes">
        @if( Content is not null )
        {
            @Content
        }
        else
        {
            @Text
        }
    </LumexComponent>
</div>
