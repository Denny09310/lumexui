@namespace LumexUI
@inherits LumexComponentBase

@using S = AccordionItemSlots;

<LumexComponent Class="@GetStyles( nameof( S.Base ) )"
                Style="@RootStyle"
                data-slot="base"
                data-opened="@_expanded"
                @attributes="@AdditionalAttributes">
    <h2 class="@GetStyles( nameof ( S.Heading ) )" data-slot="heading">
        <button type="button"
                class="@GetStyles(nameof(S.Trigger) )"
                disabled="@_disabled"
                data-slot="trigger"
                @onclick="@ToggleExpansionAsync">
            @if( StartContent is not null )
            {
                <div class="@GetStyles(nameof(S.StartContent) )" data-slot="start-content">
                    @StartContent
                </div>
            }
            <div class="@GetStyles( nameof ( S.TitleWrapper ) )" data-slot="title-wrapper">
                @if( !string.IsNullOrEmpty( Title ) || TitleContent is not null )
                {
                    <span class="@GetStyles( nameof ( S.Title ) )" data-slot="title">
                        @if( !string.IsNullOrEmpty( Title ) )
                        {
                            @Title
                        }
                        else if( TitleContent is not null )
                        {
                            @TitleContent
                        }
                    </span>
                }
                @if( !string.IsNullOrEmpty( Subtitle ) || SubtitleContent is not null )
                {
                    <span class="@GetStyles( nameof ( S.Subtitle ) )" data-slot="subtitle">
                        @if( !string.IsNullOrEmpty( Subtitle ) )
                        {
                            @Subtitle
                        }
                        else if( SubtitleContent is not null )
                        {
                            @SubtitleContent
                        }
                    </span>
                }
            </div>
            @if( Context.Owner.ShowIndicators )
            {
                <span class="@GetStyles( nameof ( S.Indicator ) )"
                      data-slot="indicator"
                      data-opened="@_expanded">
                    @IndicatorContent( _expanded )
                </span>
            }
        </button>
    </h2>

    <LumexCollapse As="section" Expanded="@_expanded">
        <div class="@GetStyles( nameof ( S.Content ) )" data-slot="content">
            @ChildContent
        </div>
    </LumexCollapse>
</LumexComponent>

@if( Context.Owner.ShowDividers
   && !Context.IsLast( this )
   && Context.Owner.Variant is not AccordionVariant.Splitted )
{
    <LumexDivider />
}