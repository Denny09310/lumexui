@page "/docs/components/breadcrumbs"
@layout DocsContentLayout

@using LumexUI.Docs.Client.Pages.Components.Breadcrumbs.PreviewCodes

<DocsCompositionSection Components="@_compositionComponents" />

<DocsSection Title="Usage">
    <Usage />
</DocsSection>

<DocsSlotsSection Slots="@_slots">
    <div>
        <h4 class="font-semibold">Breadcrumbs</h4>
        <ul>
            <li><code>Class</code>: The basic CSS class name styles the wrapper of the breadcrumb items.</li>
            <li><code>ItemClasses</code>: The CSS class names for the breadcrumb items slots style all the breadcrumb items at once.</li>
        </ul>
    </div>
    <div>
        <h4 class="font-semibold">Breadcrumb item</h4>
        <ul>
            <li><code>Class</code>: The basic CSS class name styles the wrapper of the breadcrumb item.</li>
            <li><code>Classes</code>: The CSS class names for the breadcrumb item slots style the entire breadcrumb item at once.</li>
        </ul>
    </div>
</DocsSlotsSection>

<DocsApiSection Components="@_apiComponents" />

@code {
    [CascadingParameter] private DocsContentLayout Layout { get; set; } = default!;

    private readonly CompositionComponent[] _compositionComponents = new CompositionComponent[]
    {
        new(nameof(LumexBreadcrumbs), "The container that holds collapsible sections."),
        new(nameof(LumexBreadcrumbItem), "The individual collapsible section within the breadcrumbs.")
    };

    private readonly Heading[] _headings = new Heading[]
    {
        new("Composition"),
        new("Usage"),
        new("API")
    };

    private readonly Slot[] _slots = new Slot[]
    {
        new(nameof(BreadcrumbItemSlots.Base), "The overall container of the breadcrumb item."),
        new(nameof(BreadcrumbItemSlots.Item), "The wrappper of the header section that includes the trigger."),
        new(nameof(BreadcrumbItemSlots.Separator), "The wrappper of the body content of the breadcrumb item.")
    };

    private readonly string[] _apiComponents = new string[]
    {
        nameof(LumexBreadcrumbs),
        nameof(LumexBreadcrumbItem)
    };

    protected override void OnInitialized()
    {
        Layout.Initialize(
            title: "Breadcrumbs",
            category: "Components",
            description: "Breadcrumbss present a list of top-level options that can expand or collapse to display additional details.",
            headings: _headings,
            linksProps: new ComponentLinksProps( "Breadcrumbs", isServer: false )
        );
    }
}
